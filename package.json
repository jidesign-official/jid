{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "python3 scripts/import-admin-submissions.py --root .",
    "prebuild": "python3 scripts/import-admin-submissions.py --root .",
    "postbuild": "node scripts/check-pages-size.mjs out",
    "test:admin-importer": "python3 -m unittest discover -s tests/admin_importer -p 'test_*.py'",
    "test:admin-pipeline": "node --test tests/admin_pipeline/*.test.mjs",
    "pretest:portfolio-settings": "python3 scripts/import-admin-submissions.py --root .",
    "test:portfolio-settings": "playwright test --config tests/portfolio_settings/settings.config.ts",
    "test:about-content": "playwright test --config tests/about_content/content.config.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:models": "playwright test --config tests/e2e/model-viewer.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@types/three": "^0.186.0",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
